{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/schemas/exporters/v1/request.schema.json",
  "title": "Agentics Deployment Exporters Request",
  "description": "Schema for agentics-deployment-exporters requests that generate infrastructure-as-code from deployment intents",
  "type": "object",
  "required": [
    "export_id",
    "execution_id",
    "export_format",
    "source",
    "target_config",
    "layer_trace",
    "contract_version"
  ],
  "additionalProperties": false,
  "properties": {
    "export_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this export request"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier linking this request to a specific execution context"
    },
    "export_format": {
      "type": "string",
      "enum": ["terraform", "pulumi", "cloudformation", "kubernetes", "docker-compose"],
      "description": "Target infrastructure-as-code format for the export"
    },
    "source": {
      "type": "object",
      "description": "Source references for the export",
      "required": ["intent_id"],
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "type": "string",
          "format": "uuid",
          "description": "Reference to the deployment intent being exported"
        },
        "simulation_id": {
          "type": "string",
          "format": "uuid",
          "description": "Optional reference to a simulation that validated this intent"
        },
        "diligence_id": {
          "type": "string",
          "format": "uuid",
          "description": "Optional reference to diligence artifacts for this intent"
        },
        "intent_version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "description": "Version of the intent being exported"
        }
      }
    },
    "target_config": {
      "type": "object",
      "description": "Provider-specific configuration for the export",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "object",
          "description": "Cloud provider configuration",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "enum": ["aws", "azure", "gcp", "kubernetes", "docker"],
              "description": "Target cloud provider or platform"
            },
            "region": {
              "type": "string",
              "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$",
              "description": "Target region for provider resources"
            },
            "account_id": {
              "type": "string",
              "description": "Provider account or project identifier"
            },
            "credentials_ref": {
              "type": "string",
              "description": "Reference to credentials (secret name or vault path)"
            }
          }
        },
        "terraform": {
          "type": "object",
          "description": "Terraform-specific configuration",
          "additionalProperties": false,
          "properties": {
            "backend": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["s3", "gcs", "azurerm", "consul", "local"],
                  "description": "Terraform backend type"
                },
                "config": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Backend-specific configuration"
                }
              }
            },
            "provider_version": {
              "type": "string",
              "pattern": "^~?>?=?\\s*(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "Terraform provider version constraint"
            },
            "terraform_version": {
              "type": "string",
              "pattern": "^~?>?=?\\s*(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(\\.\\d+)?$",
              "description": "Required Terraform version constraint"
            },
            "workspace": {
              "type": "string",
              "description": "Terraform workspace name"
            }
          }
        },
        "pulumi": {
          "type": "object",
          "description": "Pulumi-specific configuration",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "enum": ["typescript", "python", "go", "csharp", "java", "yaml"],
              "description": "Pulumi program language"
            },
            "stack": {
              "type": "string",
              "description": "Pulumi stack name"
            },
            "project": {
              "type": "string",
              "description": "Pulumi project name"
            },
            "backend_url": {
              "type": "string",
              "format": "uri",
              "description": "Pulumi backend URL"
            }
          }
        },
        "cloudformation": {
          "type": "object",
          "description": "CloudFormation-specific configuration",
          "additionalProperties": false,
          "properties": {
            "stack_name": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$",
              "description": "CloudFormation stack name"
            },
            "template_format": {
              "type": "string",
              "enum": ["json", "yaml"],
              "description": "Template output format"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["CAPABILITY_IAM", "CAPABILITY_NAMED_IAM", "CAPABILITY_AUTO_EXPAND"]
              },
              "description": "Required CloudFormation capabilities"
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "value"],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "description": "Parameter key"
                  },
                  "value": {
                    "type": "string",
                    "description": "Parameter value"
                  },
                  "use_previous_value": {
                    "type": "boolean",
                    "description": "Whether to use the previous value during updates"
                  }
                }
              }
            }
          }
        },
        "kubernetes": {
          "type": "object",
          "description": "Kubernetes-specific configuration",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
              "description": "Target Kubernetes namespace"
            },
            "cluster_name": {
              "type": "string",
              "description": "Target cluster name"
            },
            "api_version": {
              "type": "string",
              "description": "Kubernetes API version to target"
            },
            "output_format": {
              "type": "string",
              "enum": ["yaml", "json"],
              "description": "Output format for manifests"
            },
            "include_crds": {
              "type": "boolean",
              "description": "Whether to include CRD definitions"
            },
            "kustomize": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Whether to generate Kustomize overlays"
                },
                "base_path": {
                  "type": "string",
                  "description": "Path for Kustomize base"
                }
              }
            }
          }
        },
        "docker_compose": {
          "type": "object",
          "description": "Docker Compose-specific configuration",
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "enum": ["3.8", "3.9", "3.10"],
              "description": "Docker Compose file version"
            },
            "project_name": {
              "type": "string",
              "description": "Docker Compose project name"
            },
            "include_volumes": {
              "type": "boolean",
              "description": "Whether to include volume definitions"
            },
            "include_networks": {
              "type": "boolean",
              "description": "Whether to include network definitions"
            },
            "registry": {
              "type": "string",
              "format": "uri",
              "description": "Container registry URL"
            }
          }
        },
        "output": {
          "type": "object",
          "description": "Output configuration",
          "additionalProperties": false,
          "properties": {
            "directory": {
              "type": "string",
              "description": "Output directory path"
            },
            "filename_prefix": {
              "type": "string",
              "description": "Prefix for output filenames"
            },
            "split_by_service": {
              "type": "boolean",
              "description": "Whether to split output by service"
            },
            "include_readme": {
              "type": "boolean",
              "description": "Whether to include README documentation"
            }
          }
        }
      }
    },
    "layer_trace": {
      "type": "object",
      "description": "Trace proving which architecture layers contributed to this export",
      "required": ["foundational", "intelligence", "core", "integration_infra"],
      "additionalProperties": false,
      "properties": {
        "foundational": {
          "type": "object",
          "description": "Contribution trace from the foundational layer",
          "required": ["contributed", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "contributed": {
              "type": "boolean",
              "description": "Whether this layer contributed to the export"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "description": "Artifact ID from this layer"
              },
              "description": "Artifact IDs contributed by this layer"
            },
            "contribution_type": {
              "type": "string",
              "enum": ["infrastructure", "configuration", "security", "networking"],
              "description": "Type of contribution from this layer"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When this layer's contribution was recorded"
            }
          }
        },
        "intelligence": {
          "type": "object",
          "description": "Contribution trace from the intelligence layer",
          "required": ["contributed", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "contributed": {
              "type": "boolean",
              "description": "Whether this layer contributed to the export"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "description": "Artifact ID from this layer"
              },
              "description": "Artifact IDs contributed by this layer"
            },
            "contribution_type": {
              "type": "string",
              "enum": ["ml_models", "optimization", "prediction", "analysis"],
              "description": "Type of contribution from this layer"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When this layer's contribution was recorded"
            }
          }
        },
        "core": {
          "type": "object",
          "description": "Contribution trace from the core layer",
          "required": ["contributed", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "contributed": {
              "type": "boolean",
              "description": "Whether this layer contributed to the export"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "description": "Artifact ID from this layer"
              },
              "description": "Artifact IDs contributed by this layer"
            },
            "contribution_type": {
              "type": "string",
              "enum": ["business_logic", "workflow", "orchestration", "data_processing"],
              "description": "Type of contribution from this layer"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When this layer's contribution was recorded"
            }
          }
        },
        "integration_infra": {
          "type": "object",
          "description": "Contribution trace from the integration infrastructure layer",
          "required": ["contributed", "artifacts"],
          "additionalProperties": false,
          "properties": {
            "contributed": {
              "type": "boolean",
              "description": "Whether this layer contributed to the export"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "description": "Artifact ID from this layer"
              },
              "description": "Artifact IDs contributed by this layer"
            },
            "contribution_type": {
              "type": "string",
              "enum": ["api_gateway", "message_queue", "service_mesh", "observability"],
              "description": "Type of contribution from this layer"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time",
              "description": "When this layer's contribution was recorded"
            }
          }
        }
      }
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version of the contract schema being used"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of export request creation"
        },
        "created_by": {
          "type": "string",
          "description": "Identifier of the entity that created this export request"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid",
          "description": "Correlation ID for distributed tracing"
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid",
          "description": "Key for idempotent export operations"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for categorization"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for additional metadata"
        }
      }
    },
    "options": {
      "type": "object",
      "description": "Export options",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "type": "boolean",
          "description": "Whether to perform a dry run without generating output"
        },
        "validate_only": {
          "type": "boolean",
          "description": "Whether to only validate the export configuration"
        },
        "include_comments": {
          "type": "boolean",
          "description": "Whether to include documentation comments in output"
        },
        "minify": {
          "type": "boolean",
          "description": "Whether to minify the output"
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether to encrypt sensitive values"
            },
            "key_ref": {
              "type": "string",
              "description": "Reference to encryption key"
            },
            "algorithm": {
              "type": "string",
              "enum": ["AES-256-GCM", "RSA-OAEP"],
              "description": "Encryption algorithm"
            }
          }
        }
      }
    }
  }
}
