{
  "name": "@llm-dev-ops/contracts",
  "version": "1.2.0",
  "description": "Authoritative, enforceable contract layer for the Agentics platform",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "execution/",
    "simulation/",
    "intent/",
    "exporters/",
    "diligence/",
    "roi/",
    "governance/",
    "lifecycle/",
    "data-plane/",
    "dist/",
    "index.js",
    "index.d.ts"
  ],
  "exports": {
    ".": "./index.js",
    "./pipeline": "./dist/pipeline/index.js",
    "./execution/v1/*": "./execution/v1/*.schema.json",
    "./simulation/v1/*": "./simulation/v1/*.schema.json",
    "./intent/v1/*": "./intent/v1/*.schema.json",
    "./exporters/v1/*": "./exporters/v1/*.schema.json",
    "./diligence/v1/*": "./diligence/v1/*.schema.json",
    "./roi/v1/*": "./roi/v1/*.schema.json",
    "./governance/v1/*": "./governance/v1/*.schema.json",
    "./lifecycle/v1/*": "./lifecycle/v1/*.schema.json",
    "./data-plane/v1/*": "./data-plane/v1/*.schema.json"
  },
  "scripts": {
    "build": "tsc",
    "validate": "node scripts/validate-schemas.mjs",
    "test": "npm run validate && npm run build",
    "prepublishOnly": "npm run validate && npm run build"
  },
  "keywords": [
    "agentics",
    "contracts",
    "json-schema",
    "zod",
    "validation",
    "llm",
    "platform"
  ],
  "author": "Agentics Platform Team",
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLM-Dev-Ops/agentics-contracts.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3"
  }
}
