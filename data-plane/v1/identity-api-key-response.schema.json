{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/identity-api-key-response.schema.json",
  "title": "Tenant-bound API key lookup response",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_id", "organization_id", "name", "scopes", "created_at", "expires_at", "last_used_at"],
  "properties": {
    "key_id": { "type": "string", "format": "uuid" },
    "organization_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "scopes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true,
      "description": "An active API key response MUST contain a non-empty unique scope list that remains a subset of the provider's current allowlist; empty, malformed, duplicate, or retired scopes MUST fail closed and MUST NOT resolve as an active key."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "last_used_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
