{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/usage-ledger-entry-append.schema.json",
  "title": "Tenant-bound usage ledger entry append request",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "entry_type", "amount", "correlation_id"],
  "properties": {
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "entry_type": { "enum": ["grant", "debit"] },
    "amount": { "type": "string", "pattern": "^(?=.*[1-9])[0-9]+(\\.[0-9]{1,6})?$" },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "user_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "service": { "type": "string", "minLength": 1, "maxLength": 255 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "metadata": { "type": "object" }
  }
}
