{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/identity-api-key-lookup.schema.json",
  "title": "IAM-authenticated API key lookup request",
  "type": "object",
  "additionalProperties": false,
  "required": ["key_hash"],
  "properties": {
    "key_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
