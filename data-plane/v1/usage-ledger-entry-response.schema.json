{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/usage-ledger-entry-response.schema.json",
  "title": "Tenant-bound usage ledger entry response",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "replayed", "entry"],
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "replayed": { "type": "boolean" },
    "entry": { "$ref": "#/$defs/entry" }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entry_type", "amount", "balance_after", "correlation_id", "user_id", "service", "run_id", "metadata", "created_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+$" },
        "entry_type": { "enum": ["grant", "debit", "reservation_consume"] },
        "amount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$" },
        "balance_after": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$" },
        "correlation_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": ["string", "null"] },
        "service": { "type": ["string", "null"] },
        "run_id": { "type": ["string", "null"] },
        "metadata": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
