{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/result-index-store.schema.json",
  "title": "Tenant-bound result index store request",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "result"],
  "properties": {
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "layerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_name", "status", "duration_ms", "assertions_passed", "assertions_failed"],
      "properties": {
        "layer_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "assertions_passed": { "type": "integer", "minimum": 0 },
        "assertions_failed": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "executionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_hash", "layerRecords", "generated_at"],
      "properties": {
        "proof_hash": { "type": "string", "minLength": 1 },
        "layerRecords": { "type": "array", "items": { "$ref": "#/$defs/layerRecord" } },
        "generated_at": { "type": "string", "minLength": 1 }
      }
    },
    "executionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "proof_hash", "layers_executed", "schema_version", "environment", "started_at", "completed_at", "duration_ms"],
      "properties": {
        "execution_id": { "type": "string", "minLength": 1 },
        "proof_hash": { "type": "string", "minLength": 1 },
        "layers_executed": { "type": "array", "items": { "type": "string" } },
        "schema_version": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "number", "minimum": 0 }
      }
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_name", "environment"],
      "properties": {
        "repo_name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "triggered_by": { "type": "string" },
        "branch": { "type": "string" },
        "commit_sha": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["assertions_passed", "assertions_failed", "total_layers", "mandatory_layers_complete"],
      "properties": {
        "assertions_passed": { "type": "integer", "minimum": 0 },
        "assertions_failed": { "type": "integer", "minimum": 0 },
        "total_layers": { "type": "integer", "minimum": 0 },
        "mandatory_layers_complete": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "scenario_id", "execution_id", "simulation_id", "parent_span_id", "simulation_resolution", "repo_name", "environment", "status", "execution_metadata", "executionProof", "result_summary", "correlation_id"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "execution_id": { "type": "string", "minLength": 1 },
        "simulation_id": { "type": "string", "minLength": 1 },
        "parent_span_id": { "type": "string", "minLength": 1 },
        "simulation_resolution": { "type": "string", "minLength": 1 },
        "repo_name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "execution_metadata": { "$ref": "#/$defs/executionMetadata" },
        "executionProof": { "$ref": "#/$defs/executionProof" },
        "execution_context": { "$ref": "#/$defs/executionContext" },
        "result_summary": { "$ref": "#/$defs/summary" },
        "correlation_id": { "type": ["string", "null"] },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "completed_at", "duration_ms"],
          "properties": {
            "started_at": { "type": "string", "minLength": 1 },
            "completed_at": { "type": "string", "minLength": 1 },
            "duration_ms": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
