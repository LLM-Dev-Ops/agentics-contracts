{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/result-index-response.schema.json",
  "title": "Tenant-bound result index response",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "replayed", "entry"],
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "replayed": { "type": "boolean" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stored_at", "result"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+$" },
        "stored_at": { "type": "string", "format": "date-time" },
        "result": { "$ref": "https://agentics.org/contracts/data-plane/v1/result-index-store.schema.json#/$defs/result" }
      }
    }
  }
}
