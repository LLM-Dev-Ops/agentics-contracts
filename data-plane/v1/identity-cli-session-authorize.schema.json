{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/identity-cli-session-authorize.schema.json",
  "title": "JWT-authorized CLI session completion request",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_code"],
  "properties": {
    "session_code": { "type": "string", "pattern": "^[A-Z0-9]{8}$" },
    "key_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
