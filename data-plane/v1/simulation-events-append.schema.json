{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/simulation-events-append.schema.json",
  "title": "Simulation Events Append Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["simulation_id", "idempotency_key", "events"],
  "properties": {
    "simulation_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "payload"],
        "properties": {
          "kind": {
            "enum": ["created", "started", "step_started", "step_completed", "log", "metric", "artifact", "validation", "completed", "failed", "cancelled"]
          },
          "payload": {}
        }
      }
    }
  }
}
