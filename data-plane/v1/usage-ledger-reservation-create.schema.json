{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/usage-ledger-reservation-create.schema.json",
  "title": "Tenant-bound usage ledger reservation create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["idempotency_key", "amount", "ttl_seconds", "correlation_id"],
  "properties": {
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "amount": { "type": "string", "pattern": "^(?=.*[1-9])[0-9]+(\\.[0-9]{1,6})?$" },
    "ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "user_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "service": { "type": "string", "minLength": 1, "maxLength": 255 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 255 },
    "metadata": { "type": "object" }
  }
}
