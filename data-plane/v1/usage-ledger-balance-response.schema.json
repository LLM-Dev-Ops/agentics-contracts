{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/usage-ledger-balance-response.schema.json",
  "title": "Tenant-bound usage ledger balance response",
  "type": "object",
  "additionalProperties": false,
  "required": ["organization_id", "current_balance", "reserved_amount", "available_balance", "as_of"],
  "properties": {
    "organization_id": { "type": "string", "minLength": 1 },
    "current_balance": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$" },
    "reserved_amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$" },
    "available_balance": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$" },
    "as_of": { "type": "string", "format": "date-time" }
  }
}
