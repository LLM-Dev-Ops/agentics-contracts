{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/contracts/data-plane/v1/principal.schema.json",
  "title": "Data Plane Principal",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "principal", "organization_id", "audience", "mapping_source"],
  "properties": {
    "subject": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "format": "email" },
    "organization_id": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "mapping_source": { "const": "configured_principal_binding" }
  }
}
