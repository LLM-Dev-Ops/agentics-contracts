{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/schemas/diligence/v1/request.schema.json",
  "title": "Agentics Diligence Artifacts Request",
  "description": "Schema for agentics-diligence-artifacts requests that perform comprehensive checks across all architecture layers",
  "type": "object",
  "required": [
    "diligence_id",
    "execution_id",
    "diligence_type",
    "scope",
    "checks_required",
    "layer_coverage_requirements",
    "contract_version"
  ],
  "additionalProperties": false,
  "properties": {
    "diligence_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this diligence request"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier linking this request to a specific execution context"
    },
    "diligence_type": {
      "type": "string",
      "enum": ["security", "compliance", "performance", "cost", "full"],
      "description": "Type of diligence analysis to perform"
    },
    "scope": {
      "type": "object",
      "description": "Scope of the diligence analysis",
      "required": ["services", "layers", "time_range"],
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["service_id", "name"],
            "additionalProperties": false,
            "properties": {
              "service_id": {
                "type": "string",
                "format": "uuid",
                "description": "Unique identifier for the service"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Human-readable service name"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
                "description": "Service version to analyze"
              },
              "environment": {
                "type": "string",
                "enum": ["development", "staging", "production", "disaster-recovery"],
                "description": "Environment where the service is deployed"
              }
            }
          },
          "description": "Services to include in diligence analysis"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["foundational", "intelligence", "core", "integration_infra"]
          },
          "description": "Architecture layers to analyze"
        },
        "time_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time",
              "description": "Start of the analysis time range (ISO 8601)"
            },
            "end": {
              "type": "string",
              "format": "date-time",
              "description": "End of the analysis time range (ISO 8601)"
            },
            "timezone": {
              "type": "string",
              "pattern": "^[A-Za-z_]+/[A-Za-z_]+$",
              "description": "Timezone for the time range (e.g., 'America/New_York')"
            }
          },
          "description": "Time range for historical data analysis"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$"
          },
          "description": "Regions to include in analysis"
        },
        "exclude_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Patterns for excluding resources from analysis"
        }
      }
    },
    "checks_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,10}-[0-9]{3,6}$",
        "description": "Check identifier (e.g., 'SEC-001', 'COMP-042', 'PERF-103')"
      },
      "description": "Specific check identifiers to execute"
    },
    "layer_coverage_requirements": {
      "type": "object",
      "description": "Requirements ensuring every layer has diligence coverage",
      "required": ["foundational", "intelligence", "core", "integration_infra"],
      "additionalProperties": false,
      "properties": {
        "foundational": {
          "type": "object",
          "description": "Diligence coverage requirements for the foundational layer",
          "required": ["services", "check_types"],
          "additionalProperties": false,
          "properties": {
            "services": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["service_id"],
                "additionalProperties": false,
                "properties": {
                  "service_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Service ID from the foundational layer"
                  },
                  "name": {
                    "type": "string",
                    "description": "Service name"
                  },
                  "critical": {
                    "type": "boolean",
                    "description": "Whether this service is critical for the layer"
                  }
                }
              },
              "description": "Services requiring diligence coverage in this layer"
            },
            "check_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "vulnerability_scan",
                  "dependency_audit",
                  "configuration_review",
                  "access_control_audit",
                  "encryption_verification",
                  "network_security_scan",
                  "compliance_check",
                  "performance_baseline",
                  "resource_utilization",
                  "cost_analysis",
                  "disaster_recovery_test",
                  "backup_verification"
                ]
              },
              "description": "Types of checks to perform for this layer"
            },
            "minimum_coverage_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum coverage percentage required"
            },
            "severity_threshold": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "info"],
              "description": "Minimum severity level to report"
            }
          }
        },
        "intelligence": {
          "type": "object",
          "description": "Diligence coverage requirements for the intelligence layer",
          "required": ["services", "check_types"],
          "additionalProperties": false,
          "properties": {
            "services": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["service_id"],
                "additionalProperties": false,
                "properties": {
                  "service_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Service ID from the intelligence layer"
                  },
                  "name": {
                    "type": "string",
                    "description": "Service name"
                  },
                  "critical": {
                    "type": "boolean",
                    "description": "Whether this service is critical for the layer"
                  }
                }
              },
              "description": "Services requiring diligence coverage in this layer"
            },
            "check_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "model_validation",
                  "data_quality_check",
                  "bias_detection",
                  "model_drift_analysis",
                  "inference_performance",
                  "training_pipeline_audit",
                  "data_lineage_verification",
                  "privacy_compliance",
                  "explainability_check",
                  "adversarial_testing",
                  "feature_store_audit",
                  "model_versioning_check"
                ]
              },
              "description": "Types of checks to perform for this layer"
            },
            "minimum_coverage_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum coverage percentage required"
            },
            "severity_threshold": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "info"],
              "description": "Minimum severity level to report"
            }
          }
        },
        "core": {
          "type": "object",
          "description": "Diligence coverage requirements for the core layer",
          "required": ["services", "check_types"],
          "additionalProperties": false,
          "properties": {
            "services": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["service_id"],
                "additionalProperties": false,
                "properties": {
                  "service_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Service ID from the core layer"
                  },
                  "name": {
                    "type": "string",
                    "description": "Service name"
                  },
                  "critical": {
                    "type": "boolean",
                    "description": "Whether this service is critical for the layer"
                  }
                }
              },
              "description": "Services requiring diligence coverage in this layer"
            },
            "check_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "business_logic_validation",
                  "workflow_integrity_check",
                  "state_management_audit",
                  "transaction_consistency",
                  "error_handling_review",
                  "idempotency_verification",
                  "rate_limiting_check",
                  "circuit_breaker_test",
                  "saga_pattern_validation",
                  "event_sourcing_audit",
                  "cqrs_consistency_check",
                  "domain_model_validation"
                ]
              },
              "description": "Types of checks to perform for this layer"
            },
            "minimum_coverage_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum coverage percentage required"
            },
            "severity_threshold": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "info"],
              "description": "Minimum severity level to report"
            }
          }
        },
        "integration_infra": {
          "type": "object",
          "description": "Diligence coverage requirements for the integration infrastructure layer",
          "required": ["services", "check_types"],
          "additionalProperties": false,
          "properties": {
            "services": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["service_id"],
                "additionalProperties": false,
                "properties": {
                  "service_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Service ID from the integration infrastructure layer"
                  },
                  "name": {
                    "type": "string",
                    "description": "Service name"
                  },
                  "critical": {
                    "type": "boolean",
                    "description": "Whether this service is critical for the layer"
                  }
                }
              },
              "description": "Services requiring diligence coverage in this layer"
            },
            "check_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "api_contract_validation",
                  "message_queue_health",
                  "service_mesh_configuration",
                  "load_balancer_check",
                  "ssl_certificate_audit",
                  "dns_configuration_check",
                  "api_gateway_security",
                  "rate_limit_configuration",
                  "retry_policy_validation",
                  "timeout_configuration",
                  "tracing_coverage",
                  "logging_compliance"
                ]
              },
              "description": "Types of checks to perform for this layer"
            },
            "minimum_coverage_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Minimum coverage percentage required"
            },
            "severity_threshold": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "info"],
              "description": "Minimum severity level to report"
            }
          }
        }
      }
    },
    "contract_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semantic version of the contract schema being used"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of request creation"
        },
        "created_by": {
          "type": "string",
          "description": "Identifier of the entity that created this request"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid",
          "description": "Correlation ID for distributed tracing"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "normal", "high", "critical"],
          "description": "Priority level for this diligence request"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value labels for categorization"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value annotations for additional metadata"
        },
        "triggered_by": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["scheduled", "manual", "deployment", "alert", "policy"],
              "description": "What triggered this diligence request"
            },
            "reference_id": {
              "type": "string",
              "format": "uuid",
              "description": "Reference to the triggering entity"
            }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "description": "Diligence execution options",
      "additionalProperties": false,
      "properties": {
        "parallel_execution": {
          "type": "boolean",
          "description": "Whether to execute checks in parallel"
        },
        "max_concurrent_checks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of concurrent checks"
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "Timeout for the entire diligence process in minutes"
        },
        "fail_fast": {
          "type": "boolean",
          "description": "Whether to stop on first critical failure"
        },
        "remediation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "auto_remediate": {
              "type": "boolean",
              "description": "Whether to automatically remediate issues"
            },
            "remediation_level": {
              "type": "string",
              "enum": ["none", "low_risk", "medium_risk", "all"],
              "description": "Level of issues to auto-remediate"
            },
            "require_approval": {
              "type": "boolean",
              "description": "Whether remediation requires approval"
            }
          }
        },
        "reporting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {
              "type": "string",
              "enum": ["json", "html", "pdf", "sarif"],
              "description": "Report output format"
            },
            "include_evidence": {
              "type": "boolean",
              "description": "Whether to include evidence in the report"
            },
            "include_recommendations": {
              "type": "boolean",
              "description": "Whether to include remediation recommendations"
            },
            "notification_channels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["email", "slack", "webhook", "pagerduty"]
              },
              "description": "Channels to notify upon completion"
            }
          }
        }
      }
    },
    "compliance_frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["framework_id", "version"],
        "additionalProperties": false,
        "properties": {
          "framework_id": {
            "type": "string",
            "enum": ["SOC2", "HIPAA", "PCI-DSS", "GDPR", "ISO27001", "NIST", "FedRAMP", "SOX"],
            "description": "Compliance framework identifier"
          },
          "version": {
            "type": "string",
            "description": "Version of the compliance framework"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Specific controls to evaluate"
          }
        }
      },
      "description": "Compliance frameworks to evaluate against"
    }
  }
}
