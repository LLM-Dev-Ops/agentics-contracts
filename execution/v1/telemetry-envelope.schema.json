{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/schemas/execution/v1/telemetry-envelope.schema.json",
  "title": "Telemetry Envelope",
  "description": "Standard envelope format for telemetry data emitted by all systems in the agentics stack. Provides consistent structure for monitoring, tracing, and performance analysis.",
  "type": "object",
  "required": [
    "execution_id",
    "layer",
    "capability",
    "service",
    "version",
    "timestamps",
    "outcome",
    "trace_id",
    "span_id"
  ],
  "additionalProperties": false,
  "properties": {
    "execution_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the overall execution this telemetry belongs to",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "layer": {
      "$ref": "#/definitions/LayerType",
      "description": "The architectural layer emitting this telemetry"
    },
    "capability": {
      "type": "string",
      "description": "The capability being executed",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]{0,255}$",
      "minLength": 1,
      "maxLength": 256
    },
    "service": {
      "type": "string",
      "description": "The service or repository name emitting this telemetry",
      "pattern": "^[a-zA-Z][a-zA-Z0-9._/-]{0,255}$",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the service",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "timestamps": {
      "$ref": "#/definitions/Timestamps",
      "description": "Timing information for the execution"
    },
    "outcome": {
      "$ref": "#/definitions/Outcome",
      "description": "The outcome of the execution"
    },
    "error": {
      "$ref": "#/definitions/ErrorDetails",
      "description": "Error details if outcome is 'failure'"
    },
    "metrics": {
      "$ref": "#/definitions/Metrics",
      "description": "Performance and resource utilization metrics"
    },
    "trace_id": {
      "type": "string",
      "description": "Distributed trace ID (W3C Trace Context format)",
      "pattern": "^[a-f0-9]{32}$"
    },
    "span_id": {
      "type": "string",
      "description": "Span ID within the trace (W3C Trace Context format)",
      "pattern": "^[a-f0-9]{16}$"
    },
    "parent_span_id": {
      "type": "string",
      "description": "Parent span ID for hierarchical tracing",
      "pattern": "^[a-f0-9]{16}$"
    },
    "baggage": {
      "type": "object",
      "description": "W3C Baggage items propagated through the trace",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,255}$"
      }
    },
    "resource": {
      "$ref": "#/definitions/Resource",
      "description": "Resource attributes identifying the source of this telemetry"
    },
    "attributes": {
      "type": "object",
      "description": "Additional custom attributes for this telemetry event",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 100
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.]{0,255}$"
      }
    },
    "events": {
      "type": "array",
      "description": "Significant events that occurred during execution",
      "items": {
        "$ref": "#/definitions/SpanEvent"
      },
      "maxItems": 128
    },
    "links": {
      "type": "array",
      "description": "Links to related spans in other traces",
      "items": {
        "$ref": "#/definitions/SpanLink"
      },
      "maxItems": 32
    }
  },
  "definitions": {
    "LayerType": {
      "type": "string",
      "enum": [
        "foundational",
        "intelligence",
        "core",
        "integration",
        "infra",
        "apex"
      ],
      "description": "The architectural layer in the agentics stack"
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "partial"
      ],
      "description": "The outcome status of the execution"
    },
    "Timestamps": {
      "type": "object",
      "description": "Timing information for the execution",
      "required": [
        "received",
        "started",
        "completed"
      ],
      "additionalProperties": false,
      "properties": {
        "received": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp when the request was received"
        },
        "started": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp when processing started"
        },
        "completed": {
          "type": "string",
          "format": "date-time",
          "description": "ISO8601 timestamp when processing completed"
        },
        "queue_duration_ms": {
          "type": "integer",
          "description": "Time spent waiting in queue (received to started) in milliseconds",
          "minimum": 0
        },
        "processing_duration_ms": {
          "type": "integer",
          "description": "Time spent processing (started to completed) in milliseconds",
          "minimum": 0
        },
        "total_duration_ms": {
          "type": "integer",
          "description": "Total time (received to completed) in milliseconds",
          "minimum": 0
        }
      }
    },
    "ErrorDetails": {
      "type": "object",
      "description": "Detailed error information when outcome is 'failure'",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message",
          "maxLength": 4096
        },
        "type": {
          "type": "string",
          "enum": [
            "validation",
            "authentication",
            "authorization",
            "not_found",
            "conflict",
            "rate_limit",
            "timeout",
            "internal",
            "dependency",
            "configuration",
            "resource_exhausted"
          ],
          "description": "Category of error"
        },
        "retryable": {
          "type": "boolean",
          "description": "Whether this error is potentially recoverable via retry"
        },
        "retry_after_ms": {
          "type": "integer",
          "description": "Suggested delay before retry in milliseconds",
          "minimum": 0
        },
        "stack_trace": {
          "type": "string",
          "description": "Stack trace (only included in non-production environments)",
          "maxLength": 65536
        },
        "details": {
          "type": "object",
          "description": "Additional structured error details",
          "additionalProperties": true
        },
        "caused_by": {
          "type": "object",
          "description": "Upstream error that caused this failure",
          "additionalProperties": false,
          "properties": {
            "service": {
              "type": "string",
              "description": "Service where the upstream error originated",
              "pattern": "^[a-zA-Z][a-zA-Z0-9._/-]{0,255}$"
            },
            "code": {
              "type": "string",
              "description": "Upstream error code",
              "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
            },
            "message": {
              "type": "string",
              "description": "Upstream error message",
              "maxLength": 4096
            }
          }
        }
      }
    },
    "Metrics": {
      "type": "object",
      "description": "Performance and resource utilization metrics",
      "additionalProperties": false,
      "properties": {
        "cpu_time_ms": {
          "type": "number",
          "description": "CPU time consumed in milliseconds",
          "minimum": 0
        },
        "memory_peak_bytes": {
          "type": "integer",
          "description": "Peak memory usage in bytes",
          "minimum": 0
        },
        "memory_allocated_bytes": {
          "type": "integer",
          "description": "Total memory allocated in bytes",
          "minimum": 0
        },
        "network_bytes_sent": {
          "type": "integer",
          "description": "Network bytes sent",
          "minimum": 0
        },
        "network_bytes_received": {
          "type": "integer",
          "description": "Network bytes received",
          "minimum": 0
        },
        "disk_read_bytes": {
          "type": "integer",
          "description": "Disk bytes read",
          "minimum": 0
        },
        "disk_write_bytes": {
          "type": "integer",
          "description": "Disk bytes written",
          "minimum": 0
        },
        "db_queries": {
          "type": "integer",
          "description": "Number of database queries executed",
          "minimum": 0
        },
        "db_query_time_ms": {
          "type": "number",
          "description": "Total database query time in milliseconds",
          "minimum": 0
        },
        "cache_hits": {
          "type": "integer",
          "description": "Number of cache hits",
          "minimum": 0
        },
        "cache_misses": {
          "type": "integer",
          "description": "Number of cache misses",
          "minimum": 0
        },
        "external_calls": {
          "type": "integer",
          "description": "Number of external service calls",
          "minimum": 0
        },
        "external_call_time_ms": {
          "type": "number",
          "description": "Total external call time in milliseconds",
          "minimum": 0
        },
        "tokens_input": {
          "type": "integer",
          "description": "Number of input tokens (for LLM operations)",
          "minimum": 0
        },
        "tokens_output": {
          "type": "integer",
          "description": "Number of output tokens (for LLM operations)",
          "minimum": 0
        },
        "model_inference_time_ms": {
          "type": "number",
          "description": "Model inference time in milliseconds (for ML/LLM operations)",
          "minimum": 0
        },
        "queue_depth": {
          "type": "integer",
          "description": "Queue depth when this request was received",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "description": "Number of retries attempted",
          "minimum": 0
        },
        "custom": {
          "type": "object",
          "description": "Custom metrics specific to the service",
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.]{0,63}$"
          }
        }
      }
    },
    "Resource": {
      "type": "object",
      "description": "Resource attributes identifying the source of telemetry (OpenTelemetry semantic conventions)",
      "additionalProperties": false,
      "properties": {
        "service_name": {
          "type": "string",
          "description": "Logical name of the service",
          "pattern": "^[a-zA-Z][a-zA-Z0-9._/-]{0,255}$"
        },
        "service_version": {
          "type": "string",
          "description": "Version of the service",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "service_instance_id": {
          "type": "string",
          "description": "Unique instance identifier",
          "pattern": "^[a-zA-Z0-9_-]{1,256}$"
        },
        "service_namespace": {
          "type": "string",
          "description": "Namespace the service belongs to",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "deployment_environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "production"
          ],
          "description": "Deployment environment"
        },
        "host_name": {
          "type": "string",
          "description": "Hostname of the machine",
          "maxLength": 256
        },
        "host_id": {
          "type": "string",
          "description": "Unique host identifier",
          "pattern": "^[a-zA-Z0-9_-]{1,256}$"
        },
        "container_id": {
          "type": "string",
          "description": "Container ID if running in a container",
          "pattern": "^[a-f0-9]{64}$"
        },
        "container_name": {
          "type": "string",
          "description": "Container name",
          "maxLength": 256
        },
        "k8s_pod_name": {
          "type": "string",
          "description": "Kubernetes pod name",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "k8s_namespace": {
          "type": "string",
          "description": "Kubernetes namespace",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "k8s_deployment_name": {
          "type": "string",
          "description": "Kubernetes deployment name",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "cloud_provider": {
          "type": "string",
          "enum": [
            "aws",
            "azure",
            "gcp",
            "other"
          ],
          "description": "Cloud provider"
        },
        "cloud_region": {
          "type": "string",
          "description": "Cloud region",
          "pattern": "^[a-z]{2}-[a-z]+-[0-9]+$"
        },
        "cloud_availability_zone": {
          "type": "string",
          "description": "Cloud availability zone",
          "pattern": "^[a-z]{2}-[a-z]+-[0-9]+[a-z]$"
        }
      }
    },
    "SpanEvent": {
      "type": "object",
      "description": "A significant event that occurred during span execution",
      "required": [
        "name",
        "timestamp"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Event name",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.]{0,255}$",
          "minLength": 1,
          "maxLength": 256
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the event occurred"
        },
        "attributes": {
          "type": "object",
          "description": "Event attributes",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.]{0,255}$"
          }
        }
      }
    },
    "SpanLink": {
      "type": "object",
      "description": "A link to a related span in another trace",
      "required": [
        "trace_id",
        "span_id"
      ],
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string",
          "description": "Trace ID of the linked span",
          "pattern": "^[a-f0-9]{32}$"
        },
        "span_id": {
          "type": "string",
          "description": "Span ID of the linked span",
          "pattern": "^[a-f0-9]{16}$"
        },
        "trace_state": {
          "type": "string",
          "description": "W3C Trace State of the linked span",
          "maxLength": 512
        },
        "attributes": {
          "type": "object",
          "description": "Link attributes describing the relationship",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.]{0,255}$"
          }
        }
      }
    }
  }
}
