{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentics.org/schemas/governance/v1/policy.schema.json",
  "title": "Agentics Platform Governance Policy",
  "description": "Defines governance policies that enforce platform correctness across all architectural layers",
  "type": "object",
  "properties": {
    "policy_id": {
      "$ref": "definitions.schema.json#/definitions/uuid_format",
      "description": "Unique identifier for this governance policy"
    },
    "policy_version": {
      "$ref": "definitions.schema.json#/definitions/semver_format",
      "description": "Semantic version of this policy definition"
    },
    "policy_type": {
      "type": "string",
      "enum": [
        "execution",
        "deployment",
        "access",
        "data",
        "compliance"
      ],
      "description": "Classification of the policy type"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_. -]*$",
      "description": "Human-readable name for the policy"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Detailed description of what this policy enforces and why"
    },
    "enforcement_level": {
      "type": "string",
      "enum": [
        "strict",
        "warning",
        "audit"
      ],
      "description": "How strictly this policy is enforced: strict blocks violations, warning allows with notification, audit only logs"
    },
    "scope": {
      "type": "object",
      "description": "Defines the scope where this policy applies",
      "properties": {
        "environments": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/environment_enum"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Environments where this policy is active"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/layer_enum"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Platform layers targeted by this policy"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/service_pattern"
          },
          "description": "Service name patterns with glob support (* matches any characters, ** matches across namespaces)"
        },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "uniqueItems": true,
          "description": "Logical namespaces where this policy applies"
        },
        "principals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "principal_type": {
                "type": "string",
                "enum": [
                  "user",
                  "service_account",
                  "agent",
                  "system",
                  "external_service",
                  "federated_identity"
                ]
              },
              "principal_pattern": {
                "type": "string",
                "description": "Pattern to match principal identifiers"
              }
            },
            "required": ["principal_type"]
          },
          "description": "Principal types and patterns this policy applies to"
        },
        "exclude_services": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/service_pattern"
          },
          "description": "Service patterns explicitly excluded from this policy"
        },
        "exclude_namespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$"
          },
          "description": "Namespaces explicitly excluded from this policy"
        }
      },
      "required": ["environments", "layers"],
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/policy_rule"
      },
      "minItems": 1,
      "description": "Collection of rules that define the policy behavior"
    },
    "layer_enforcement": {
      "type": "object",
      "description": "CRITICAL: Ensures all platform layers follow this policy",
      "properties": {
        "foundational": {
          "$ref": "#/definitions/layer_enforcement_config"
        },
        "intelligence": {
          "$ref": "#/definitions/layer_enforcement_config"
        },
        "core": {
          "$ref": "#/definitions/layer_enforcement_config"
        },
        "integration_infra": {
          "$ref": "#/definitions/layer_enforcement_config"
        },
        "apex": {
          "$ref": "#/definitions/layer_enforcement_config"
        }
      },
      "required": [
        "foundational",
        "intelligence",
        "core",
        "integration_infra",
        "apex"
      ],
      "additionalProperties": false
    },
    "contract_requirements": {
      "type": "object",
      "description": "Requirements for contracts that must be satisfied for policy compliance",
      "properties": {
        "minimum_contract_version": {
          "$ref": "definitions.schema.json#/definitions/semver_format",
          "description": "Minimum contract version required for compliance"
        },
        "required_schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9/_.-]+\\.schema\\.json$"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Schema paths that must be validated for compliance"
        },
        "execution_graph_required": {
          "type": "boolean",
          "const": true,
          "description": "Execution graph is required for all policy-governed operations"
        },
        "telemetry_required": {
          "type": "boolean",
          "const": true,
          "description": "Telemetry emission is required for all policy-governed operations"
        },
        "contract_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "service_contract",
              "data_contract",
              "api_contract",
              "sla_contract",
              "governance_contract"
            ]
          },
          "uniqueItems": true,
          "description": "Types of contracts that must exist for compliance"
        },
        "schema_validation_mode": {
          "type": "string",
          "enum": [
            "strict",
            "lenient",
            "warn_only"
          ],
          "default": "strict",
          "description": "How strictly schema validation is enforced"
        }
      },
      "required": [
        "minimum_contract_version",
        "required_schemas",
        "execution_graph_required",
        "telemetry_required"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "Policy metadata including lifecycle and approval information",
      "properties": {
        "created_at": {
          "$ref": "definitions.schema.json#/definitions/timestamp_format",
          "description": "Timestamp when this policy was created"
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Identifier of the principal who created this policy"
        },
        "approved_by": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "approver_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "approver_role": {
                "type": "string",
                "enum": [
                  "platform_admin",
                  "security_admin",
                  "compliance_officer",
                  "service_owner",
                  "team_lead",
                  "architect",
                  "sre"
                ]
              },
              "approved_at": {
                "$ref": "definitions.schema.json#/definitions/timestamp_format"
              },
              "approval_notes": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": ["approver_id", "approver_role", "approved_at"],
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "List of approvers who authorized this policy"
        },
        "effective_from": {
          "$ref": "definitions.schema.json#/definitions/timestamp_format",
          "description": "Timestamp when this policy becomes effective"
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "definitions.schema.json#/definitions/timestamp_format"
            },
            {
              "type": "null"
            }
          ],
          "description": "Timestamp when this policy expires, or null for no expiration"
        },
        "last_reviewed_at": {
          "$ref": "definitions.schema.json#/definitions/timestamp_format",
          "description": "Timestamp of the last policy review"
        },
        "review_frequency_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "description": "How often this policy should be reviewed"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "maxLength": 64
          },
          "uniqueItems": true,
          "description": "Tags for categorization and search"
        },
        "compliance_frameworks": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/compliance_framework"
          },
          "uniqueItems": true,
          "description": "Compliance frameworks this policy helps satisfy"
        },
        "documentation_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to detailed policy documentation"
        },
        "change_log": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "$ref": "definitions.schema.json#/definitions/semver_format"
              },
              "changed_at": {
                "$ref": "definitions.schema.json#/definitions/timestamp_format"
              },
              "changed_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "change_description": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": ["version", "changed_at", "changed_by", "change_description"],
            "additionalProperties": false
          },
          "description": "History of changes to this policy"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "approved_by",
        "effective_from",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 500,
      "description": "Policy evaluation priority (lower numbers evaluated first)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this policy is currently active"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "policy_id": {
            "$ref": "definitions.schema.json#/definitions/uuid_format"
          },
          "policy_name": {
            "type": "string"
          },
          "dependency_type": {
            "type": "string",
            "enum": [
              "requires",
              "extends",
              "conflicts_with",
              "supersedes"
            ]
          }
        },
        "required": ["policy_id", "dependency_type"],
        "additionalProperties": false
      },
      "description": "Dependencies and relationships with other policies"
    },
    "violation_handling": {
      "type": "object",
      "description": "Configuration for handling policy violations",
      "properties": {
        "notification_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "email",
              "slack",
              "pagerduty",
              "webhook",
              "sns",
              "pubsub",
              "audit_log"
            ]
          },
          "uniqueItems": true
        },
        "escalation_policy": {
          "type": "object",
          "properties": {
            "initial_severity": {
              "$ref": "definitions.schema.json#/definitions/severity_level"
            },
            "escalate_after_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10080
            },
            "escalation_severity": {
              "$ref": "definitions.schema.json#/definitions/severity_level"
            },
            "max_escalations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "additionalProperties": false
        },
        "auto_remediation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "remediation_action": {
              "type": "string",
              "enum": [
                "rollback",
                "quarantine",
                "disable_service",
                "rate_limit",
                "custom_webhook"
              ]
            },
            "require_approval": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "policy_id",
    "policy_version",
    "policy_type",
    "name",
    "description",
    "enforcement_level",
    "scope",
    "rules",
    "layer_enforcement",
    "contract_requirements",
    "metadata"
  ],
  "additionalProperties": false,
  "definitions": {
    "policy_rule": {
      "type": "object",
      "description": "Individual rule within a governance policy",
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique identifier for this rule within the policy"
        },
        "rule_type": {
          "type": "string",
          "enum": [
            "require_layer",
            "require_service",
            "forbid",
            "rate_limit",
            "approval_required"
          ],
          "description": "Type of rule being defined"
        },
        "condition": {
          "$ref": "#/definitions/rule_condition",
          "description": "Condition that triggers this rule"
        },
        "action": {
          "type": "string",
          "enum": [
            "block",
            "warn",
            "log",
            "require_approval"
          ],
          "description": "Action to take when the rule condition is met"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Human-readable message explaining the policy violation"
        },
        "severity": {
          "$ref": "definitions.schema.json#/definitions/severity_level",
          "description": "Severity level of violations of this rule"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this rule is currently active"
        },
        "time_window": {
          "$ref": "definitions.schema.json#/definitions/time_window",
          "description": "Optional time window when this rule is active"
        },
        "rate_limit_config": {
          "$ref": "definitions.schema.json#/definitions/rate_limit_config",
          "description": "Rate limiting configuration (required for rate_limit rule_type)"
        },
        "approval_config": {
          "$ref": "definitions.schema.json#/definitions/approval_requirement",
          "description": "Approval configuration (required for approval_required rule_type)"
        },
        "required_layers": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/layer_enum"
          },
          "uniqueItems": true,
          "description": "Layers that must be involved (for require_layer rule_type)"
        },
        "required_services": {
          "type": "array",
          "items": {
            "$ref": "definitions.schema.json#/definitions/service_pattern"
          },
          "description": "Services that must be involved (for require_service rule_type)"
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern_type": {
                "type": "string",
                "enum": [
                  "service_call",
                  "data_access",
                  "layer_transition",
                  "resource_usage",
                  "configuration"
                ]
              },
              "pattern": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["pattern_type", "pattern"],
            "additionalProperties": false
          },
          "description": "Patterns that are forbidden (for forbid rule_type)"
        },
        "exception_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rule_condition"
          },
          "description": "Conditions under which this rule does not apply"
        },
        "metadata": {
          "type": "object",
          "properties": {
            "rationale": {
              "type": "string",
              "maxLength": 2000,
              "description": "Explanation of why this rule exists"
            },
            "compliance_controls": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Compliance controls this rule helps satisfy"
            },
            "references": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "description": "External references for this rule"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "rule_id",
        "rule_type",
        "condition",
        "action",
        "message"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "rule_type": {
                "const": "rate_limit"
              }
            }
          },
          "then": {
            "required": ["rate_limit_config"]
          }
        },
        {
          "if": {
            "properties": {
              "rule_type": {
                "const": "approval_required"
              }
            }
          },
          "then": {
            "required": ["approval_config"]
          }
        },
        {
          "if": {
            "properties": {
              "rule_type": {
                "const": "require_layer"
              }
            }
          },
          "then": {
            "required": ["required_layers"]
          }
        },
        {
          "if": {
            "properties": {
              "rule_type": {
                "const": "require_service"
              }
            }
          },
          "then": {
            "required": ["required_services"]
          }
        },
        {
          "if": {
            "properties": {
              "rule_type": {
                "const": "forbid"
              }
            }
          },
          "then": {
            "required": ["forbidden_patterns"]
          }
        }
      ],
      "additionalProperties": false
    },
    "rule_condition": {
      "type": "object",
      "description": "Flexible condition definition for rule evaluation",
      "properties": {
        "condition_type": {
          "type": "string",
          "enum": [
            "simple",
            "compound",
            "temporal",
            "contextual",
            "resource_based",
            "principal_based"
          ],
          "description": "Type of condition"
        },
        "field": {
          "type": "string",
          "description": "Field path to evaluate (for simple conditions)"
        },
        "operator": {
          "$ref": "definitions.schema.json#/definitions/condition_operator",
          "description": "Comparison operator"
        },
        "value": {
          "description": "Value to compare against",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_operator": {
          "$ref": "definitions.schema.json#/definitions/logical_operator",
          "description": "Logical operator for combining sub-conditions"
        },
        "sub_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rule_condition"
          },
          "minItems": 1,
          "description": "Nested conditions for compound conditions"
        },
        "context_requirements": {
          "type": "object",
          "properties": {
            "layer": {
              "$ref": "definitions.schema.json#/definitions/layer_enum"
            },
            "environment": {
              "$ref": "definitions.schema.json#/definitions/environment_enum"
            },
            "principal_type": {
              "type": "string",
              "enum": [
                "user",
                "service_account",
                "agent",
                "system",
                "external_service",
                "federated_identity"
              ]
            },
            "resource_type": {
              "type": "string"
            },
            "operation": {
              "type": "string",
              "enum": [
                "create",
                "read",
                "update",
                "delete",
                "execute",
                "deploy",
                "configure"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Contextual requirements for this condition"
        },
        "temporal_constraints": {
          "type": "object",
          "properties": {
            "time_window": {
              "$ref": "definitions.schema.json#/definitions/time_window"
            },
            "effective_from": {
              "$ref": "definitions.schema.json#/definitions/timestamp_format"
            },
            "effective_until": {
              "$ref": "definitions.schema.json#/definitions/timestamp_format"
            },
            "recurrence": {
              "type": "string",
              "enum": [
                "once",
                "daily",
                "weekly",
                "monthly",
                "quarterly",
                "annually"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Time-based constraints for condition evaluation"
        },
        "resource_constraints": {
          "type": "object",
          "properties": {
            "resource_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "service",
                  "workflow",
                  "agent",
                  "data_store",
                  "model",
                  "endpoint",
                  "secret",
                  "configuration",
                  "execution_graph",
                  "telemetry_stream",
                  "policy",
                  "contract"
                ]
              },
              "uniqueItems": true
            },
            "resource_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "resource_tags": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Resource-based constraints for condition evaluation"
        },
        "principal_constraints": {
          "type": "object",
          "properties": {
            "principal_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "user",
                  "service_account",
                  "agent",
                  "system",
                  "external_service",
                  "federated_identity"
                ]
              },
              "uniqueItems": true
            },
            "required_roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required_attributes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "description": "Principal-based constraints for condition evaluation"
        },
        "negate": {
          "type": "boolean",
          "default": false,
          "description": "Whether to negate the result of this condition"
        }
      },
      "required": ["condition_type"],
      "allOf": [
        {
          "if": {
            "properties": {
              "condition_type": {
                "const": "simple"
              }
            }
          },
          "then": {
            "required": ["field", "operator", "value"]
          }
        },
        {
          "if": {
            "properties": {
              "condition_type": {
                "const": "compound"
              }
            }
          },
          "then": {
            "required": ["logical_operator", "sub_conditions"]
          }
        },
        {
          "if": {
            "properties": {
              "condition_type": {
                "const": "temporal"
              }
            }
          },
          "then": {
            "required": ["temporal_constraints"]
          }
        },
        {
          "if": {
            "properties": {
              "condition_type": {
                "const": "resource_based"
              }
            }
          },
          "then": {
            "required": ["resource_constraints"]
          }
        },
        {
          "if": {
            "properties": {
              "condition_type": {
                "const": "principal_based"
              }
            }
          },
          "then": {
            "required": ["principal_constraints"]
          }
        }
      ],
      "additionalProperties": false
    },
    "layer_enforcement_config": {
      "type": "object",
      "description": "Configuration for policy enforcement at a specific layer",
      "properties": {
        "enforced": {
          "type": "boolean",
          "description": "Whether this policy is enforced at this layer"
        },
        "policy_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "description": "Rule IDs from the rules array that apply to this layer"
          },
          "uniqueItems": true,
          "description": "Specific rules enforced at this layer"
        },
        "enforcement_mode": {
          "type": "string",
          "enum": [
            "blocking",
            "non_blocking",
            "dry_run"
          ],
          "default": "blocking",
          "description": "How enforcement is applied at this layer"
        },
        "exemptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exemption_id": {
                "$ref": "definitions.schema.json#/definitions/uuid_format"
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "approved_by": {
                "type": "string"
              },
              "expires_at": {
                "$ref": "definitions.schema.json#/definitions/timestamp_format"
              },
              "service_patterns": {
                "type": "array",
                "items": {
                  "$ref": "definitions.schema.json#/definitions/service_pattern"
                }
              }
            },
            "required": ["exemption_id", "reason", "approved_by"],
            "additionalProperties": false
          },
          "description": "Exemptions from enforcement at this layer"
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "metrics_enabled": {
              "type": "boolean",
              "default": true
            },
            "alerting_enabled": {
              "type": "boolean",
              "default": true
            },
            "sampling_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1.0
            }
          },
          "additionalProperties": false,
          "description": "Monitoring configuration for this layer"
        }
      },
      "required": ["enforced", "policy_rules"],
      "additionalProperties": false
    }
  }
}
